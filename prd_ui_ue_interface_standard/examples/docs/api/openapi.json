{
  "openapi": "3.0.3",
  "info": {
    "title": "订单接口（反面示例）",
    "version": "1.0.0",
    "description": "故意留有两个一致性问题：payMethod 未登记在数据字典.csv；ORDER_2999 不在错误码文案表中。"
  },
  "paths": {
    "/order/list": {
      "get": {
        "summary": "订单列表",
        "operationId": "listOrders",
        "x-error-codes": ["OK", "AUTH_401", "ORDER_2999"],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "list": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/Order" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Order": {
        "type": "object",
        "properties": {
          "orderNo": { "type": "string" },
          "status": { "type": "string" },
          "amount": { "type": "string" },
          "payMethod": {
            "type": "string",
            "description": "支付方式 —— 本字段未登记在数据字典.csv 中"
          }
        }
      }
    }
  }
}
