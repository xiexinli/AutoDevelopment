# AutoDevelopment 平台后端 · 环境变量示例（**复制为 .env 后填写；切勿提交真实密钥**）

# 服务端口（默认 8787）
AD_PORT=8787

# SQLite 数据库文件（默认 server/data/app.db）
# AD_DB_PATH=/absolute/path/app.db

# 日志级别：fatal | error | warn | info | debug | trace
AD_LOG_LEVEL=info

# ---- 飞书开放平台（**留空则使用开发适配器**：扫码由 /auth/feishu/qrcode/{state}/simulate 显式推进）----
# 真机扫码登录需要在飞书开放平台创建应用、配置重定向并开通相应权限。
AD_FEISHU_APP_ID=
AD_FEISHU_APP_SECRET=

# ---- 本地账号密码登录（#72；开发阶段的登录方式）----
# development = 启用账号密码登录，且「任意合法用户名 + 开发密码」可自助开通（**仅本地**）
# 未设置或其它值 = 关闭（fail-closed）
# ⚠️ 生产请设为 disabled，改用企业自建应用扫码或你们自己的账号体系。
# AD_PASSWORD_LOGIN=development
# 初始账号与开发密码（密码只存 scrypt 哈希，不落明文）
# AD_DEV_USERNAME=admin
# AD_DEV_PASSWORD=

# ---- 第三方大模型（B2 起使用；密钥只存在于服务端，绝不下发浏览器）----
# AD_LLM_BASE_URL=
# AD_LLM_API_KEY=

# LLM 默认未配置时拒绝审核/拆解（不静默降级）
# 如只验本地 HTTP 链路，显式 AD_LLM_MODE=development（标题规则测试桩，非语义审核）
# AD_LLM_MODE=development
# AD_LLM_BASE_URL 为你提供的网关（本实现约定 POST /v1/review /v1/split），不是通用模型聊天端点

# B3 codegen，默认缺配置拒绝生成；development=确定性布局编译器，非AI
# AD_CODEGEN_MODE=development
# AD_CODEGEN_BASE_URL=
# AD_CODEGEN_API_KEY=
# 本地构建代理候选鉴权：secret只存在服务端/受信代理，普通网页登录令牌无权自报可信L2
# AD_BUILD_AGENT_SECRET=

# ==================== 真实上游接入（2026-10-21） ====================
#
# ⚠️ 不配置 = fail-closed（生成类接口返回明确错误，不会静默用桩）。
# ⚠️ 想用确定性桩联调 UI，必须**显式**：AD_LLM_MODE=development / AD_CODEGEN_MODE=development

# ---- 大模型：任意 OpenAI 兼容的 /chat/completions ----
# 本机 LM Studio 示例（无需密钥）：
#   AD_LLM_BASE_URL=http://127.0.0.1:1234/v1
#   AD_LLM_MODEL=qwen/qwen3.6-35b-a3b
# 云端示例：AD_LLM_BASE_URL=https://api.deepseek.com/v1  AD_LLM_MODEL=deepseek-chat  AD_LLM_API_KEY=***
AD_LLM_BASE_URL=
AD_LLM_MODEL=
AD_LLM_API_KEY=
# 单次调用上限（契约默认 60000）。本机大模型较慢时可放大，例如 180000
# AD_LLM_TIMEOUT_MS=60000
# JSON 输出模式：默认 none（不发 response_format，兼容性最好）；
# 上游明确支持时可设 json_object / json_schema
# 可选：模型目录文件（前端「选择模型」用）。缺省 server/data/llm-catalog.json；
# 由 tools/gen-llm-catalog.mjs 生成；没有该文件时只显示 AD_LLM_MODEL 一个模型。
# AD_LLM_CATALOG_FILE=
# 可选：采样温度；本机 DHwork 端点不支持该参数时会自动摘除并重试，也可直接设 off 不发送
# AD_LLM_TEMPERATURE=0.2
# 可选：JSON 输出模式：默认 none（不发 response_format，兼容性最好）
# AD_LLM_JSON_MODE=none
# 单次任务上限（契约默认 300000 = 5min）。本机大模型串行生成 5 份 Spec 会超时可放大
# AD_TASK_TIMEOUT_MS=300000

# ---- 飞书 ----
# 方式一（生产）：应用凭据 + 回调地址；扫码登录走授权码流程
AD_FEISHU_APP_ID=
AD_FEISHU_APP_SECRET=
# 必须与开放平台「重定向 URL」白名单一致，例如 http://127.0.0.1:8787/api/v1/auth/feishu/callback
AD_FEISHU_REDIRECT_URI=
# 方式二（本地联调）：个人 user_access_token，以**当前用户身份**读他有权限的云文档。
# ⚠️ 这是个人令牌，不是平台应用凭据，只用于本地验证，**不要用于生产**；也不要提交进版本库。
AD_FEISHU_USER_TOKEN=
